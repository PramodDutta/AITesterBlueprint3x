# Streamlit Community Cloud secrets.
# Copy to .streamlit/secrets.toml locally, or paste into the app's
# "Secrets" box when deploying. Keys match the .env names exactly; app.py
# copies them into the environment before configuration is read.

LLM_MODEL = "deepseek/deepseek-v4-flash"
LLM_API_KEY = "sk-..."
LLM_TEMPERATURE = "0.1"

JIRA_INTEGRATION_MODE = "auto"
JIRA_URL = "https://your-domain.atlassian.net"
JIRA_AUTH_MODE = "basic"
JIRA_EMAIL = "you@example.com"
JIRA_API_TOKEN = "..."

JIRA_MCP_TRANSPORT = "streamable_http"
JIRA_MCP_URL = ""
JIRA_MCP_GET_ISSUE_TOOL = ""

PIPELINE_MAX_TICKETS = "20"
DEMO_MODE = "false"
