{
  "key": "VWO-48",
  "fields": {
    "summary": "Shopping cart total shows $0.00 after applying discount code",
    "issuetype": {
      "name": "Bug"
    },
    "status": {
      "name": "To Do"
    },
    "priority": {
      "name": "Medium"
    },
    "labels": [
      "checkout",
      "regression",
      "revenue"
    ],
    "components": [
      {
        "name": "Shopping Cart"
      }
    ],
    "parent": {
      "key": "VWO-40"
    },
    "subtasks": [],
    "issuelinks": [
      {
        "type": {
          "name": "relates to"
        },
        "outwardIssue": {
          "key": "VWO-49"
        }
      }
    ],
    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Environment: Production, Chrome 120, Windows 11. Severity as reported: High."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Steps to Reproduce"
            }
          ]
        },
        {
          "type": "orderedList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Add 3 or more items to the shopping cart so the subtotal is above $50."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Apply the discount code \"SAVE20\" (20% off)."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Observe the cart total."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Actual Result"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The cart total shows $0.00 instead of the discounted price."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Expected Result"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The cart total shows the original subtotal minus 20%."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Acceptance Criteria"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Applying SAVE20 to a cart with 3 or more items shows subtotal minus 20%."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Applying SAVE20 to a cart with 1 or 2 items continues to show subtotal minus 20%."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The total displayed in the cart always equals the discountedTotal returned by the cart API."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The cart total is never rendered as $0.00 while the cart contains at least one item."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Additional Info"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Happens only when the cart has 3 or more items."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Works correctly with 1 to 2 items."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Started after the deployment of v2.4.1 last Friday."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "No errors appear in the browser console."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The API response contains the correct discounted amount."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "comment": {
      "comments": [
        {
          "author": {
            "displayName": "Priya"
          },
          "body": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Reproduced on staging with 4 items. Network tab shows discountedTotal: 72.00 while the UI renders $0.00."
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}