# Sample environment file. Copy to .env and fill in your own values.
#   cp .env.sample .env
# Real .env files are gitignored and must never be committed.

APP_NAME=Jira QA Crew
APP_ENV=development
OUTPUT_DIR=outputs
LOG_LEVEL=INFO

# Live Jira. Set DEMO_MODE=true to read ./fixtures instead.
# token. Set to false once JIRA_API_TOKEN below is refreshed.
DEMO_MODE=false

LLM_MODEL=deepseek/deepseek-v4-flash
LLM_API_KEY=sk-your_openai_api_key_here
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=your_llm_max_tokens_here
# DeepSeek cannot enforce JSON schemas (HTTP 400 on response_format=json_schema),
# so skip the probe: the schema goes in the prompt and is validated locally.
LLM_STRUCTURED_OUTPUT=prompt

JIRA_INTEGRATION_MODE=auto
JIRA_URL=https://bugzz.atlassian.net
JIRA_AUTH_MODE=your_jira_auth_mode_here
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_atlassian_api_token_here
JIRA_API_VERSION=3
JIRA_INCLUDE_COMMENTS=true
JIRA_MAX_COMMENTS=20

JIRA_MCP_TRANSPORT=streamable_http
JIRA_MCP_URL=
JIRA_MCP_GET_ISSUE_TOOL=
JIRA_MCP_TIMEOUT_SECONDS=20

PIPELINE_MAX_TICKETS=20
PIPELINE_TICKET_TIMEOUT_SECONDS=900
