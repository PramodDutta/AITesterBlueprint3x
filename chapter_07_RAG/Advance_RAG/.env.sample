# Sample environment file. Copy to .env and fill in your own values.
#   cp .env.sample .env
# Real .env files are gitignored and must never be committed.

# Local secrets — gitignored. Do not commit.
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
BGE_USE_FP16=1

QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=vwo_test_cases

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_N_HYBRID=20
TOP_K_RERANK=4
RRF_K=60
REWRITE_ENABLED=1
INGEST_BATCH=16
PORT=5050
