# Sample environment file. Copy to .env and fill in your own values.
#   cp .env.sample .env
# Real .env files are gitignored and must never be committed.

# Groq key (same account as the chatbot under test)
GROQ_API_KEY=gsk_your_groq_api_key_here

# The judge that scores every metric. Deliberately a different model family
# from the chatbot under test (qwen), so it is not grading its own sibling.
JUDGE_MODEL=openai/gpt-oss-120b
JUDGE_BASE_URL=https://api.groq.com/openai/v1

# Subsystem A - the app under test
CHATBOT_URL=http://localhost:8201

# Subsystem B - the RAG Explorer, used by the retrieval metrics
RAG_URL=http://localhost:8202
