# Sample environment file. Copy to .env and fill in your own values.
#   cp .env.sample .env
# Real .env files are gitignored and must never be committed.

GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
CONFIDENT_API_KEY=confident_us_your_confident_ai_key_here
# rag/chat.py default is llama-3.3-70b-versatile, which this Groq key cannot access.
RAG_MODEL=qwen/qwen3.8-27b
